{
	"name": "frankerfacez",
	"author": "Dan Salvato LLC",
	"version": "4.82.0",
	"description": "FrankerFaceZ is a Twitch enhancement suite.",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"start": "bun run dev",
		"eslint": "eslint \"src/**/*.{js,jsx,vue,ts,tsx}\" \"types/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rimraf dist",
		"dev": "NODE_ENV=development rspack serve",
		"dev:prod": "NODE_ENV=production rspack serve",
		"dev:ext": "NODE_ENV=development FFZ_EXTENSION=true rspack serve",
		"build": "bun run build:prod",
		"build:ext": "NODE_ENV=production FFZ_EXTENSION=true rspack build",
		"build:stats": "NODE_ENV=production rspack build --json > stats.json",
		"build:prod": "NODE_ENV=production rspack build",
		"build:dev": "NODE_ENV=development rspack build",
		"serve:dist": "bun tools/serve-dist.js",
		"layout:site": "bun tools/layout-site.js",
		"build:types": "tsc --declaration --emitDeclarationOnly --outDir typedist && bun bin/build_types",
		"abuild:types": "bun bin/build_types",
		"build:docs": "typedoc --options typedoc.json",
		"font": "bun run font:edit",
		"font:edit": "fontello-cli --cli-config fontello.client.json edit",
		"font:save": "fontello-cli --cli-config fontello.client.json save && bun run font:update",
		"font:update": "bun bin/update_fonts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ffz/fontello-cli": "^1.0.4",
		"@rspack/cli": "^2.2.2",
		"@rspack/core": "^2.2.2",
		"@rspack/dev-server": "^2.2.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/chrome": "^0.2.8",
		"@types/crypto-js": "^4.2.2",
		"@types/js-cookie": "^3.0.6",
		"@types/safe-regex": "^1.1.6",
		"@types/vue-clickaway": "^2.2.4",
		"@types/webpack-env": "^1.18.8",
		"browserslist": "^4.25.0",
		"css-loader": "^7.1.5",
		"esbuild-loader": "^4",
		"eslint": "^10.9.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-vue": "^10.10.0",
		"glob": "^13.0.6",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"minify-graphql-loader": "^1.0.2",
		"rimraf": "^6.1.3",
		"rspack-manifest-plugin": "^5.2.2",
		"sass": "^1.104.0",
		"sass-loader": "^17.0.1",
		"semver": "^7.7.2",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.13.0",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typedoc-plugin-no-inherit": "^1.6.1",
		"typedoc-plugin-rename-defaults": "^0.7.3",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "5",
		"vue-eslint-parser": "^10.4.1",
		"vue-loader": "^15.11.1",
		"vue-template-compiler": "^2.7.16"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FrankerFaceZ/FrankerFaceZ.git"
	},
	"dependencies": {
		"@ffz/icu-msgparser": "^2.0.0",
		"@popperjs/core": "^2.11.8",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.13",
		"denoflare-mqtt": "^0.0.2",
		"displacejs": "^1.4.1",
		"emoji-regex": "^10.6.0",
		"file-saver": "^2.0.5",
		"graphql": "17",
		"graphql-tag": "^2.12.6",
		"js-cookie": "^3.0.5",
		"jszip": "^3.10.1",
		"markdown-it": "15",
		"markdown-it-link-attributes": "4",
		"mnemonist": "^0.40.4",
		"path-to-regexp": "^3.3.0",
		"raven-js": "^3.27.2",
		"react": "^18.3.1",
		"safe-regex": "^2.1.1",
		"sortablejs": "^1.15.6",
		"sourcemapped-stacktrace": "^1.1.11",
		"text-diff": "^1.0.1",
		"vue": "^2.7.16",
		"vue-clickaway": "^2.2.2",
		"vue-color": "^2.8.2",
		"vue-observe-visibility": "^1.0.0",
		"vuedraggable": "^2.24.3"
	}
}
